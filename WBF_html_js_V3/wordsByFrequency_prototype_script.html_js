//------------------------------------------------------------
	
	let prototype_lemmaTD = `
				<div style="display:none;">§one-f_lemma§</div>
				<div class="hpad top left1 §topBorder§"  style="width:100%;">										
					<span §displayNoneL§  class="c_lemma" onmouseover='mouseOverWord(this,3)' onmouseout='mouseOutWord(this,3)'><b>§one-f_lemma§</b></span>
					<span  class="c_paradigma" onmouseover='mouseOverWord(this,3)' onmouseout='mouseOutWord(this,3)'>§one-x_para1§</span>						
					<br   class="c_paradigma"  >	
					<div  class="c_wordTran" style="visibility: hidden;">§one-f_tran§</div>						
					<div   class="c_example"  >§one-x_example1§</div>
				</div> \n					
		`; 	// end of prototype_lemmaTD
//------------------------------------------------	
	
	let prototype_oneTR_lemma = `\n  
		<tr> 
			<td class="fixWordTdWidth5" style="text-align:center;font-size:0.8em;font-weight:100;">
					<span onmouseover="mouseOverWord(this)" onmouseout="mouseOutWord(this)"  >§one-numTR§</span>					
					<span style="display:none;">
						<span>§one-word1§</span>    
						<span>§ixW2StudyLs§</span>
						<span>§one-ix1§</span>
						<span>§one-ixixLemma§</span>	
						<span>§one-ixLemma§</span>	
					</span>	
			</td>  
			<td class="fixWordTdWidth5" style="text-align:center;"  class="borderVert_L"  >         <span §dyNoneTD234§>§one-nrow§</span></td> 
			<td class="fixWordTdWidth5" style="text-align:center;color:blue;" class="borderVert_L" ><span §dyNoneTD234§>§one-n_extr_row§</span></td> 
			<td class="fixWordTdWidth5" style="text-align:center;" class="borderVert_L"  >	        <span §dyNoneTD234§>
				<button §learnedClass§ onclick="onclick_word_known2(\'§one-ix1§\',this)">§YESorNOT§</button></span>
			</td>		
			<td style="text-align:center;" class="fixWordTdWidthN borderVert_L" >
				<div class="c_size_nn_line">
					<div class="hpad top left1"  >
						<span ondblclick="onclickDoubleWordTran(this)"> 
							<span class="c_wordOrig"><b>§one-word1§</b></span>						
						</span> 					
						<span  class="c_wordTran" style="display:none;">§one-f_tran§</span>		
					</div>	
				</div>	
			</td>	
			<td class="fixWordTdWidth2" style="width:1em;  font-size:0.8em;">
					<button onclick="onclick_changeTraduzione(this,\'§one-ix1§\')">.</button>
			</td>
			<td style="text-align:center;"  class="fixWordTdWidthL borderVert_L borderVert_R">
				<div class="c_size_1_line">
				§tdLemma§			
				</div>
			</td>
		
			<td class="fixWordTdWidth3">
				<button class="buttonWhite" onclick="onclick_tts_playSynthVoice_word3Freq(this,'§one-word1§', false,false)"> 
					<span style="font-size:2em;height:1.4em;">${speakinghead_symb}</span>
				</button>
            </td>
			<td  class="fixWordTdWidth3 c_m0">
                <button class="buttonWhite" onclick="onclick_tts_playSynthVoice_word3Freq(this,'§one-word1§', false,true )">
					<span style="font-size:2em;height:1.4em;">${speakinghead_symb}</span><span style="font-size:0.9em;">&plus;</span>
                </button>
            </td>
            <td  class="fixWordTdWidth3 c_m0">
                <button class="buttonWhite" onclick="onclick_tts_playSynthVoice_word3Freq(this,'§one-word1§', true, false)">
					<span style="font-size:2em;height:1.4em;">${speakinghead_symb}</span><span style="font-size:0.9em;">${word_pause_symb}</span>
